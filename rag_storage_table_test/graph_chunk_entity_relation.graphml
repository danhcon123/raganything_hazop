</edge>
<edge source="El40" target="Ukca Mark">
  <data key="d7">1.0</data>
  <data key="d8">The EL40 carries the UKCA Mark certification in accordance with the Supply Machinery (Safety) Regulations 2008.</data>
  <data key="d9">certification,regulatory compliance</data>
