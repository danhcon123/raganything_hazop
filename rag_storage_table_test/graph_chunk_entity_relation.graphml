<edge source="Enapter Ems" target="Modbus Tcp">
  <data key="d7">1.0</data>
  <data key="d8">The Enapter EMS uses Modbus TCP over Ethernet for communication and control of the EL40.</data>
  <data key="d9">communication protocol,network connectivity</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
