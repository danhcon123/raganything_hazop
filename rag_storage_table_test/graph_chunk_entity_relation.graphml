</edge>
<edge source="Enapter Ems" target="Wi-Fi">
  <data key="d7">1.0</data>
  <data key="d8">The Enapter EMS utilizes 2.4 GHz Wi-Fi for wireless control and monitoring of the EL40.</data>
  <data key="d9">remote access,wireless connectivity</data>
