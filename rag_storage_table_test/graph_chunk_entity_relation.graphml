<edge source="El40" target="Water Electrolysis">
  <data key="d7">1.0</data>
  <data key="d8">The EL40 uses water electrolysis as its core process to produce hydrogen gas from water.</data>
  <data key="d9">hydrogen production,process method</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
