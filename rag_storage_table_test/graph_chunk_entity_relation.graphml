  <data key="d13"></data>
</edge>
<edge source="El40" target="Hydrogen">
  <data key="d7">1.0</data>
  <data key="d8">The EL40 produces hydrogen gas as its primary output, achieving up to 500 NL/h at purities of 99.9% at 35 barg.</data>
  <data key="d9">gas generation,product output</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1790625504</data>
  <data key="d13"></data>
</edge>
<edge source="El40" target="Enapter Ems">
  <data key="d7">1.0</data>
  <data key="d8">The EL40 is controlled and monitored fully automatically by the Enapter EMS.</data>
  <data key="d9">control system,monitoring</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1790625505</data>
  <data key="d13"></data>
</edge>
<edge source="El40" target="Ce Mark">
  <data key="d7">1.0</data>
  <data key="d8">The EL40 carries the CE Mark certification in accordance with the Machine Directive 2006/42/CE.</data>
  <data key="d9">certification,regulatory compliance</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
