<graph edgedefault="undirected"><node id="El 4.0">
  <data key="d0">El 4.0</data>
  <data key="d1">artifact</data>
  <data key="d2">El 4.0 is Enapter's patented anion exchange membrane electrolyser, described as a standardised, stackable, and flexible system designed to produce on-site hydrogen, with a modular design and advanced software integration enabling setup in minutes and remote control.</data>
  <data key="d3">chunk-6a29f1e1c3b9b3f952782bad0da34359</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1790542142</data>
  <data key="d6"></data>
</node>
<node id="Enapter">
  <data key="d0">Enapter</data>
  <data key="d1">organization</data>
  <data key="d2">Enapter is the company that developed and patented the EL 4.0 AEM electrolyser for on-site hydrogen production.</data>
  <data key="d3">chunk-6a29f1e1c3b9b3f952782bad0da34359</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1790542142</data>
  <data key="d6"></data>
</node>
<node id="Anion Exchange Membrane">
  <data key="d0">Anion Exchange Membrane</data>
  <data key="d1">concept</data>
  <data key="d2">Anion Exchange Membrane is a membrane technology utilized in the EL 4.0 electrolyser for hydrogen production.</data>
  <data key="d3">chunk-6a29f1e1c3b9b3f952782bad0da34359</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1790542143</data>
  <data key="d6"></data>
</node>
<node id="Hydrogen">
  <data key="d0">Hydrogen</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Hydrogen is the chemical substance produced on-site by the EL 4.0 electrolyser, with flowrate adjustable through stacking.</data>
  <data key="d3">chunk-6a29f1e1c3b9b3f952782bad0da34359</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1790542143</data>
  <data key="d6"></data>
</node>
<node id="Advanced Software Integration">
  <data key="d0">Advanced Software Integration</data>
  <data key="d1">method</data>
  <data key="d2">Advanced Software Integration is a system feature of the EL 4.0 that enables setup in minutes and remote control and management of the electrolyser.</data>
  <data key="d3">chunk-6a29f1e1c3b9b3f952782bad0da34359</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1790542143</data>
  <data key="d6"></data>
</node>
<node id="Modular Design">
  <data key="d0">Modular Design</data>
  <data key="d1">concept</data>
  <data key="d2">Modular Design is the design philosophy of the EL 4.0 that allows the electrolyser to be stacked to achieve the required hydrogen flowrate.</data>
  <data key="d3">chunk-6a29f1e1c3b9b3f952782bad0da34359</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1790542143</data>
  <data key="d6"></data>
</node>
<node id="Www.Enapter.Com/Aem-Electrolyser">
  <data key="d0">Www.Enapter.Com/Aem-Electrolyser</data>
  <data key="d1">content</data>
  <data key="d2">Www.Enapter.Com/Aem-Electrolyser is the product web page URL for the AEM Electrolyser EL 4.0, providing information about Enapter's anion exchange membrane electrolyser.</data>
  <data key="d3">chunk-6a29f1e1c3b9b3f952782bad0da34359</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1790542143</data>
  <data key="d6"></data>
</node>
