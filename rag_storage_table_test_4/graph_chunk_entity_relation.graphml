  <data key="d12">1790710781</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="Control and Monitoring">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 control and monitoring function is fully automatic with Enapter's EMS via 2.4 GHz Wi-Fi and Bluetooth and Modbus TCP over Ethernet.</data>
  <data key="d9">control system,has_parameter</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
