<edge source="EL 4.0" target="Enapter's EMS">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 is fully automatically controlled and monitored by Enapter's EMS via 2.4 GHz Wi-Fi and Bluetooth and Modbus TCP over Ethernet.</data>
  <data key="d9">controlled_by,monitored_by</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
