</edge>
<edge source="EL 4.0" target="Hydrogen">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 produces hydrogen at up to 500 NL/h, up to 1.0785 kg/24 h, with output purity of 99.9% at 35 barg and 98.8% at 8 barg.</data>
  <data key="d9">process output,produces</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1790710782</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="Water">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 consumes water at approximately 420 mL/h at 25 °C, with water input pressure of 1 – 4 barg.</data>
  <data key="d9">consumes,utility input</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1790710782</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="Electricity">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 consumes electricity supplied at 220 – 240 V (AC), 50/60 Hz, with an operative power consumption of 2.4 kW (beginning of life) and peak power consumption of 3 kW.</data>
  <data key="d9">consumes,utility input</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1790710783</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="Water Electrolysis">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 uses water electrolysis to generate hydrogen from water.</data>
  <data key="d9">hydrogen generation,uses</data>
  <data key="d10">chunk-ccc2a7da10d8d7b6995d26a2b7d87a82</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1790710783</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="Conformity">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 conformity comprises the CE mark according to machine directive 2006/42/CE, the UKCA mark according to Supply Machinery (Safety) Regulations 2008, and CSA/ANSI B22734:2023 Ed.1.</data>
  <data key="d9">conforms_to,regulatory compliance</data>
