<node id="CSA/ANSI B22734:2023 Ed.1">
  <data key="d0">CSA/ANSI B22734:2023 Ed.1</data>
  <data key="d1">standard</data>
  <data key="d2">CSA/ANSI B22734:2023 Ed.1 is a standard for hydrogen generators using water electrolysis for industrial, commercial, and residential applications; conformity is limited to ETL recognized electrolyser versions.</data>
  <data key="d3">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792057797</data>
  <data key="d6"></data>
</node>
