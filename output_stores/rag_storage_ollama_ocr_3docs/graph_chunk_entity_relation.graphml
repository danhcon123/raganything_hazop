  <data key="d0">Cooling</data>
  <data key="d1">process</data>
  <data key="d2">Cooling is an intervention performed on an ongoing basis in the process industries, for example in reactors.</data>
  <data key="d3">chunk-572c717a6680b77ac4993917925a97b7</data>
  <data key="d4">SITRANS-P-EN.pdf</data>
  <data key="d5">1792058716</data>
