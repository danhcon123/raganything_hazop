  <data key="d1">operatinglimit</data>
  <data key="d2">The SITRANS P200/210/220 family covers low, medium, and high pressure ranges from 600 mbar to 1,000 bar, with different diaphragm materials by range.</data>
  <data key="d3">chunk-c6086d150f1c9fad29deb5294d8a5301</data>
  <data key="d4">SITRANS-P-EN.pdf</data>
  <data key="d5">1792059390</data>
  <data key="d6"></data>
</node>
