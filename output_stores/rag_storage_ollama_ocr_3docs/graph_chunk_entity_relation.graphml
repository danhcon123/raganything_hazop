<node id="Hazard Identification">
  <data key="d0">Hazard Identification</data>
  <data key="d1">process</data>
  <data key="d2">The SDS progression runs from hazard identification in Sections 10-11 to environmental fate in Section 12, disposal in Section 13, and transport in Section 14.</data>
  <data key="d3">chunk-2ed4ba62bbb6bbb3cdf90d8cfba89dc3</data>
