</edge>
<edge source="Container" target="Corrosion">
  <data key="d7">1.0</data>
  <data key="d8">Containers should not be stored in conditions likely to encourage corrosion.</data>
  <data key="d9">protected_from</data>
  <data key="d10">chunk-360cb75b7b6c18d60b1c4f91e5d2a671</data>
  <data key="d11">Hydrogen_compressed_Datasheet.pdf</data>
  <data key="d12">1792061364</data>
  <data key="d13"></data>
</edge>
<edge source="Container" target="Fire Risk">
  <data key="d7">1.0</data>
  <data key="d8">Containers must be stored in a location free from fire risk and away from sources of heat and ignition.</data>
  <data key="d9">stored_away_from</data>
  <data key="d10">chunk-360cb75b7b6c18d60b1c4f91e5d2a671</data>
  <data key="d11">Hydrogen_compressed_Datasheet.pdf</data>
  <data key="d12">1792061364</data>
