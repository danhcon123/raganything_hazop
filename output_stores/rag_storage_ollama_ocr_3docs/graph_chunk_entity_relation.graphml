  <data key="d3">chunk-360cb75b7b6c18d60b1c4f91e5d2a671</data>
  <data key="d4">Hydrogen_compressed_Datasheet.pdf</data>
  <data key="d5">1792061272</data>
  <data key="d6"></data>
</node>
<node id="Explosion-Proof Equipment">
  <data key="d0">Explosion-Proof Equipment</data>
  <data key="d1">equipment</data>
  <data key="d2">Explosion-proof equipment is suitable for use where there is a risk of a potentially explosive atmosphere.</data>
  <data key="d3">chunk-360cb75b7b6c18d60b1c4f91e5d2a671</data>
  <data key="d4">Hydrogen_compressed_Datasheet.pdf</data>
  <data key="d5">1792061272</data>
  <data key="d6"></data>
</node>
<node id="Ignition Source">
  <data key="d0">Ignition Source</data>
  <data key="d1">other</data>
  <data key="d2">Ignition sources, including static discharges, must be kept away from the product and containers.</data>
  <data key="d3">chunk-360cb75b7b6c18d60b1c4f91e5d2a671</data>
  <data key="d4">Hydrogen_compressed_Datasheet.pdf</data>
  <data key="d5">1792061273</data>
  <data key="d6"></data>
</node>
<node id="Static Discharge">
  <data key="d0">Static Discharge</data>
  <data key="d1">other</data>
  <data key="d2">Static discharges are a potential ignition source; precautionary measures against static discharges must be taken and equipment must be electrically earthed.</data>
  <data key="d3">chunk-360cb75b7b6c18d60b1c4f91e5d2a671</data>
  <data key="d4">Hydrogen_compressed_Datasheet.pdf</data>
  <data key="d5">1792061273</data>
  <data key="d6"></data>
</node>
<node id="Occupational Exposure Limit">
  <data key="d0">Occupational Exposure Limit</data>
  <data key="d1">operatinglimit</data>
  <data key="d2">No occupational exposure limits have been established for this product; ventilation must ensure the defined occupational exposure limit is not exceeded.</data>
  <data key="d3">chunk-360cb75b7b6c18d60b1c4f91e5d2a671</data>
  <data key="d4">Hydrogen_compressed_Datasheet.pdf</data>
  <data key="d5">1792061273</data>
