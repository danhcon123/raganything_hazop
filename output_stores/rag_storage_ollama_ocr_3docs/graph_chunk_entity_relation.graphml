<edge source="EL 4.0" target="EL 4.0 :: Production Rate">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 has a production rate of up to 500 NL/h, up to 1.0785 kg/24 h, equivalent to 0.5 Nm³/h.</data>
  <data key="d9">has_parameter</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057804</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Hydrogen Output Purity">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 hydrogen output purity is 99.9% at 35 barg and 98.8% at 8 barg, with specified H₂O and O₂ impurity limits at 25 °C.</data>
  <data key="d9">has_parameter</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057805</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Output Pressure">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 output pressure is up to 35 barg.</data>
  <data key="d9">has_limit</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057806</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Nominal Power Consumption per Nm³ of H₂ Produced">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 nominal power consumption per Nm³ of H₂ produced is 4.8 kWh/Nm³, beginning of life.</data>
  <data key="d9">has_parameter</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057806</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Operative Power Consumption">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 operative power consumption is 2.4 kW, beginning of life.</data>
  <data key="d9">has_parameter</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057807</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Peak Power Consumption">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 peak power consumption is 3 kW.</data>
  <data key="d9">has_limit</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057807</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Heat Dissipation">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 heat dissipation is 0.6 kW, beginning of life.</data>
  <data key="d9">has_parameter</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057807</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Max Heat Dissipation">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 maximum heat dissipation is 0.9 kW, end of life.</data>
  <data key="d9">has_limit</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057808</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Standby Power Consumption">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 standby power consumption is 0.3 kW; standby is the condition in which no hydrogen is produced and auxiliary components are not powered.</data>
  <data key="d9">has_parameter</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057808</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Power Supply">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 power supply is 220 – 240 V (AC), 50/60 Hz.</data>
  <data key="d9">has_parameter</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057809</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Maximum Water Input Conductivity">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 maximum water input conductivity requires minimum ASTM D1193-06 Type IV water or recommended Type II or Type III water.</data>
  <data key="d9">has_limit</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057809</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Water Consumption">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 water consumption is approximately 420 mL/h at 25 °C.</data>
  <data key="d9">has_parameter</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057810</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Water Input Pressure Range">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 water input pressure range is 1 – 4 barg.</data>
  <data key="d9">has_limit</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057810</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Ambient Operative Temperature Range">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 ambient operative temperature range is 5 °C – 45 °C.</data>
  <data key="d9">has_limit</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057811</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Ambient Operative Humidity Range">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 ambient operative humidity range is up to 90% humidity, non-condensing.</data>
  <data key="d9">has_limit</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057811</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: IP Rating">
  <data key="d7">1.0</data>
  <data key="d8">The EL 4.0 IP rating is IP 20.</data>
  <data key="d9">has_parameter</data>
  <data key="d10">chunk-b04ddc1618376e2d935f2885e7799a35</data>
  <data key="d11">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d12">1792057812</data>
  <data key="d13"></data>
</edge>
<edge source="EL 4.0" target="EL 4.0 :: Dimensions">
