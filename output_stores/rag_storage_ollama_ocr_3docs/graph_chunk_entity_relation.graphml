  <data key="d0">Disclaimer</data>
  <data key="d1">document</data>
  <data key="d2">The disclaimer states that the information is believed to be correct and should be used to make an independent determination of methods to safeguard workers and the environment.</data>
  <data key="d3">chunk-c0c034b2641f77a2e80ced6c44548bcc</data>
