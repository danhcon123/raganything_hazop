  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Standby Power Consumption</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a standby power consumption of 0.3 kW.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055444</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Power Supply">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Power Supply</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a power supply of 220 – 240 V (AC), 50/60 Hz.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055445</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Maximum Water Input Conductivity">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Maximum Water Input Conductivity</data>
  <data key="d1">operatinglimit</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a maximum water input conductivity specified as minimum ASTM D1193-06 Type IV or recommended Type II or Type III.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055445</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Water Consumption">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Water Consumption</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a water consumption of ~420 mL/h at 25 °C.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055445</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Water Input Pressure Range">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Water Input Pressure Range</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a water input pressure range of 1 – 4 barg.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055446</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Ambient Operative Temperature Range">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Ambient Operative Temperature Range</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has an ambient operative temperature range of 5 °C – 45 °C.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055446</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Ambient Operative Humidity Range">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Ambient Operative Humidity Range</data>
  <data key="d1">operatingparameter</data>
