<graph edgedefault="undirected"><node id="AEM Electrolyser EL 4.0">
  <data key="d0">AEM Electrolyser EL 4.0</data>
  <data key="d1">equipment</data>
  <data key="d2">AEM Electrolyser EL 4.0 is Enapter's patented anion exchange membrane (AEM) electrolyser, a standardised, stackable and flexible system to produce on-site hydrogen; it has a modular design with advanced software integration that allows set up in minutes and remote control and management.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055311</data>
  <data key="d6"></data>
</node>
<node id="Enapter">
  <data key="d0">Enapter</data>
  <data key="d1">organization</data>
  <data key="d2">Enapter is the organization associated with the patented AEM Electrolyser EL 4.0 and provides the Enapter website for product information.&lt;SEP&gt;Enapter is the organization that developed the patented anion exchange membrane electrolyser EL 4.0 and its EMS.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641&lt;SEP&gt;chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055455</data>
  <data key="d6"></data>
</node>
<node id="Anion Exchange Membrane (AEM)">
  <data key="d0">Anion Exchange Membrane (AEM)</data>
  <data key="d1">component</data>
  <data key="d2">Anion exchange membrane (AEM) is the patented membrane technology used in Enapter's electrolyser for hydrogen production.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055312</data>
  <data key="d6"></data>
</node>
<node id="Hydrogen">
  <data key="d0">Hydrogen</data>
  <data key="d1">substance</data>
  <data key="d2">Hydrogen is the substance produced on-site by the AEM Electrolyser EL 4.0.&lt;SEP&gt;Hydrogen is produced by the Enapter AEM Electrolyser EL 4.0, with output purity specified at 35 barg and 8 barg.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641&lt;SEP&gt;chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055450</data>
  <data key="d6"></data>
</node>
<node id="On-Site Hydrogen Production">
  <data key="d0">On-Site Hydrogen Production</data>
  <data key="d1">process</data>
  <data key="d2">On-site hydrogen production is the process performed by the AEM Electrolyser EL 4.0 to generate hydrogen at the point of use.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055313</data>
  <data key="d6"></data>
</node>
<node id="Hydrogen Flowrate">
  <data key="d0">Hydrogen Flowrate</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">Hydrogen flowrate is the required production rate that can be achieved by stacking AEM Electrolyser EL 4.0 units; no numeric value is specified in the source.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055313</data>
  <data key="d6"></data>
</node>
<node id="Standby Condition">
  <data key="d0">Standby Condition</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">Standby condition refers to the condition in which no hydrogen is being produced and the auxiliary components are not powered.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055314</data>
  <data key="d6"></data>
</node>
<node id="Auxiliary Components">
  <data key="d0">Auxiliary Components</data>
  <data key="d1">component</data>
  <data key="d2">Auxiliary components are electrolyser components that are not powered during standby.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055314</data>
  <data key="d6"></data>
</node>
<node id="Advanced Software Integration">
  <data key="d0">Advanced Software Integration</data>
  <data key="d1">controlsystem</data>
  <data key="d2">Advanced software integration allows set up in minutes and remote control and management of the AEM Electrolyser EL 4.0.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055315</data>
  <data key="d6"></data>
</node>
<node id="Remote Control And Management">
  <data key="d0">Remote Control And Management</data>
  <data key="d1">controlsystem</data>
  <data key="d2">Remote control and management is a capability of the AEM Electrolyser EL 4.0 enabled by advanced software integration.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055315</data>
  <data key="d6"></data>
</node>
<node id="Battery Limits">
  <data key="d0">Battery Limits</data>
  <data key="d1">document</data>
  <data key="d2">Battery limits are a referenced source that should be checked together with the Owner's Manual for the complete requirements list.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055316</data>
  <data key="d6"></data>
</node>
<node id="Owner's Manual">
  <data key="d0">Owner's Manual</data>
  <data key="d1">document</data>
  <data key="d2">Owner's Manual is a referenced document that should be checked for the complete requirements list for the AEM Electrolyser EL 4.0.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055316</data>
  <data key="d6"></data>
</node>
<node id="Pressure Equipment Directive 2014/68/EU">
  <data key="d0">Pressure Equipment Directive 2014/68/EU</data>
  <data key="d1">standard</data>
  <data key="d2">Pressure Equipment Directive 2014/68/EU is the European directive according to which the AEM Electrolyser EL 4.0 belongs to the S.E.P. category.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055316</data>
  <data key="d6"></data>
</node>
<node id="S.E.P. Category">
  <data key="d0">S.E.P. Category</data>
  <data key="d1">safetyrequirement</data>
  <data key="d2">S.E.P. category is the pressure equipment safety classification to which the AEM Electrolyser EL 4.0 belongs according to Pressure Equipment Directive 2014/68/EU and Pressure Equipment (Safety) Regulations 2016.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055317</data>
  <data key="d6"></data>
</node>
<node id="Pressure Equipment (Safety) Regulations 2016">
  <data key="d0">Pressure Equipment (Safety) Regulations 2016</data>
  <data key="d1">standard</data>
  <data key="d2">Pressure Equipment (Safety) Regulations 2016 is the UK regulation according to which the AEM Electrolyser EL 4.0 belongs to the S.E.P. category.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055317</data>
  <data key="d6"></data>
</node>
<node id="ETL">
  <data key="d0">ETL</data>
  <data key="d1">organization</data>
  <data key="d2">ETL is the organization associated with recognition of electrolyser versions.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055318</data>
  <data key="d6"></data>
</node>
<node id="ETL Recognized Electrolyser Versions">
  <data key="d0">ETL Recognized Electrolyser Versions</data>
  <data key="d1">standard</data>
  <data key="d2">ETL recognized electrolyser versions are the only electrolyser versions recognized under the ETL notation.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055319</data>
  <data key="d6"></data>
</node>
<node id="Enapter Website">
  <data key="d0">Enapter Website</data>
  <data key="d1">document</data>
  <data key="d2">Enapter website at www.enapter.com/aem-electrolyser is the location for the most recent specifications of the AEM Electrolyser EL 4.0.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055319</data>
  <data key="d6"></data>
</node>
<node id="AEM Electrolyser EL 4.0 :: Hydrogen Flowrate">
  <data key="d0">AEM Electrolyser EL 4.0 :: Hydrogen Flowrate</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The required hydrogen flowrate of the AEM Electrolyser EL 4.0 is achieved by stacking the electrolyser; no numeric value is specified in the source.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055320</data>
  <data key="d6"></data>
</node>
<node id="AEM Electrolyser EL 4.0 :: Standby Condition">
  <data key="d0">AEM Electrolyser EL 4.0 :: Standby Condition</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">Standby refers to the condition of the AEM Electrolyser EL 4.0 in which no hydrogen is being produced and the auxiliary components are not powered.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055320</data>
  <data key="d6"></data>
</node>
<node id="AEM Electrolyser EL 4.0 :: Setup Time">
  <data key="d0">AEM Electrolyser EL 4.0 :: Setup Time</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The AEM Electrolyser EL 4.0 allows set up in minutes, enabled by its modular design paired with advanced software integration; no numeric value is specified in the source.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055321</data>
  <data key="d6"></data>
</node>
<node id="Complete Requirements List">
  <data key="d0">Complete Requirements List</data>
  <data key="d1">document</data>
  <data key="d2">The complete requirements list is the set of requirements to be checked in the Battery limits and the Owner's Manual for the AEM Electrolyser EL 4.0.</data>
  <data key="d3">chunk-93ea68f378840f4523d46204f5b6f641</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055321</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 Specifications Table (table)">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 Specifications Table (table)</data>
  <data key="d1">table</data>
  <data key="d2">Two-column specification table for Enapter AEM Electrolyser EL 4.0. Lists production up to 500 NL/h (1.0785 kg/24h), purity at 35/8 barg, up to 35 barg output, 4.8 kWh/Nm³, 2.4 kW operation, 3 kW peak, water and ambient requirements, dimensions, weight, controls, and CE/UKCA/CSA conformity. It supports the surrounding text by detailing the modular, stackable, remotely managed electrolyser’s performance, utilities, and compliance for on-site hydrogen production.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055370</data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0">
  <data key="d0">Enapter AEM Electrolyser EL 4.0</data>
  <data key="d1">equipment</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 is Enapter’s patented anion exchange membrane electrolyser, described as standardised, stackable, flexible, modular, software-integrated, and able to produce on-site hydrogen; the table details its technical basis for stacking units to achieve a required hydrogen flowrate.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055441</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Production Rate">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Production Rate</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a production rate of up to 500 NL/h, up to 1.0785 kg/24 h.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055441</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Hydrogen Output Purity">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Hydrogen Output Purity</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a hydrogen output purity of 99.9% at 35 barg with &lt;1,000 ppm H₂O and &lt;5 ppm O₂ at 25 °C, and 98.8% at 8 barg with &lt;12,000 ppm H₂O and &lt;5 ppm O₂ at 25 °C.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055441</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Output Pressure">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Output Pressure</data>
  <data key="d1">operatinglimit</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has an output pressure limit of up to 35 barg.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055442</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Nominal Power Consumption per Nm³ of H₂ Produced">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Nominal Power Consumption per Nm³ of H₂ Produced</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a nominal power consumption per Nm³ of H₂ produced of 4.8 kWh/Nm³, beginning of life.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055442</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Operative Power Consumption">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Operative Power Consumption</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has an operative power consumption of 2.4 kW, beginning of life.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055443</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Peak Power Consumption">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Peak Power Consumption</data>
  <data key="d1">operatinglimit</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a peak power consumption of 3 kW.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055443</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Heat Dissipation">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Heat Dissipation</data>
  <data key="d1">operatingparameter</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a heat dissipation of 0.6 kW, beginning of life.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055444</data>
  <data key="d6"></data>
</node>
<node id="Enapter AEM Electrolyser EL 4.0 :: Max Heat Dissipation">
  <data key="d0">Enapter AEM Electrolyser EL 4.0 :: Max Heat Dissipation</data>
  <data key="d1">operatinglimit</data>
  <data key="d2">The Enapter AEM Electrolyser EL 4.0 has a max heat dissipation of 0.9 kW, end of life.</data>
  <data key="d3">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
  <data key="d4">Enapter_Datasheet_EL40_EN.pdf</data>
  <data key="d5">1792055444</data>
  <data key="d6"></data>
</node>
