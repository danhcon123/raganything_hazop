  <data key="d7">1.0</data>
  <data key="d8">The Enapter AEM Electrolyser EL 4.0 conforms to CE mark according to the machine directive 2006/42/CE.</data>
  <data key="d9">conforms_to</data>
  <data key="d10">chunk-d9f905a36fae7e407107d1a11e7b7200</data>
