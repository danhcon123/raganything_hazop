<node id="Water">
  <data key="d0">Water</data>
  <data key="d1">substance</data>
  <data key="d2">Water is consumed by the Enapter AEM Electrolyser EL 4.0, with consumption of ~420 mL/h at 25 °C and input pressure range of 1–4 barg.</data>
