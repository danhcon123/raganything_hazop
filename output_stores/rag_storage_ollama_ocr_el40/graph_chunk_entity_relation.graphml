<node id="Oxygen">
  <data key="d0">Oxygen</data>
  <data key="d1">substance</data>
  <data key="d2">Oxygen is produced by the Enapter AEM Electrolyser EL 4.0, with output purity specified as &lt;5 ppm O₂ at both 35 barg and 8 barg.</data>
